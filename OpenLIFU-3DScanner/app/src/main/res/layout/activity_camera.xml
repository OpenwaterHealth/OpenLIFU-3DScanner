<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CameraActivity"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_face_detection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:name="health.openwater.openlifu3dscanner.fragments.FaceDetectionFragment"
        android:visibility="visible"/>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_photo_capture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:name="health.openwater.openlifu3dscanner.fragments.PhotoCaptureFragment"
        android:visibility="gone"/>

</FrameLayout>